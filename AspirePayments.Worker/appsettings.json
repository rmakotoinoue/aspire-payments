{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Worker": {
    "ConsumingEnabled": true,
    "ProcessingDelayMilliseconds": 0,
    "MaxAttempts": 3,
    "PrefetchCount": 1
  },
  "PaymentGateway": {
    "SimulatedLatencyMilliseconds": 250
  },
  "Outbox": {
    "PollIntervalMilliseconds": 500,
    "BatchSize": 20,
    "RetryDelayMilliseconds": 5000
  }
}
