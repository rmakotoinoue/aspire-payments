@AspirePayments.Api_HostAddress = http://localhost:5162

### Health check
GET {{AspirePayments.Api_HostAddress}}/alive
Accept: application/json

### Create an order and request its payment (idempotent)
# @name createOrder
POST {{AspirePayments.Api_HostAddress}}/api/orders
Content-Type: application/json
Idempotency-Key: demo-order-001

{
  "totalAmount": 149.90,
  "currency": "BRL",
  "paymentMethod": "SimulatedCard",
  "scenario": "Succeed"
}

### Replay the same request: 202 with isIdempotentReplay = true
POST {{AspirePayments.Api_HostAddress}}/api/orders
Content-Type: application/json
Idempotency-Key: demo-order-001

{
  "totalAmount": 149.90,
  "currency": "BRL",
  "paymentMethod": "SimulatedCard",
  "scenario": "Succeed"
}

### List the most recent orders
GET {{AspirePayments.Api_HostAddress}}/api/orders
Accept: application/json

### Get one order (replace the id with a value returned above)
GET {{AspirePayments.Api_HostAddress}}/api/orders/00000000-0000-0000-0000-000000000000
Accept: application/json

### Request a partial refund of a captured payment
POST {{AspirePayments.Api_HostAddress}}/api/orders/00000000-0000-0000-0000-000000000000/refunds
Content-Type: application/json
Idempotency-Key: demo-refund-001

{
  "amount": 10.00,
  "scenario": "Succeed",
  "reason": "Customer request"
}

### Stream payment status changes (Server-Sent Events)
GET {{AspirePayments.Api_HostAddress}}/api/events
Accept: text/event-stream

### OpenAPI document (Development only)
GET {{AspirePayments.Api_HostAddress}}/openapi/v1.json
Accept: application/json
